    },
    {
      "parameters": {
        "jsCode": "// PERSIAPAN DATA\nconst inputData = $input.first().json.body || {};\nconst namaUser = inputData.pushname || \"Kak\";\nconst jam = new Date().getHours();\nlet sapaanWaktu = \"Pagi\";\nif (jam >= 11 && jam < 15) sapaanWaktu = \"Siang\";\nelse if (jam >= 15 && jam < 19) sapaanWaktu = \"Sore\";\nelse if (jam >= 19 || jam < 4) sapaanWaktu = \"Malam\";\n\nlet msg = \"\";\nif (inputData.message && inputData.message.text) {\n  msg = inputData.message.text;\n} else if (inputData.message && inputData.message.conversation) {\n  msg = inputData.message.conversation;\n}\n\nreturn {\n  json: {\n    keyword: msg.toLowerCase().trim(),\n    pesan_asli: msg,\n    sender_number: inputData.from,\n    sender_name: namaUser,\n    waktu: sapaanWaktu\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1060,
        0
      ],
      "id": "persiapan-data",
      "name": "Persiapan Data"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analisa pesan ini: \"{{ $('Persiapan Data').first().json.pesan_asli }}\"\n\nKategorikan niat user:\n1. CATALOG (Minta gambar)\n2. FREE (Minta file gratis)\n3. CHAT (Tanya jawab)\n\nJawab satu kata: CATALOG / FREE / CHAT",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -840,
        0
      ],
      "id": "otak-groq",
      "name": "Klasifikasi Niat (Groq)"
    },
