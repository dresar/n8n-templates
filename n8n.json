        "jsCode": "// FORMAT DATA\nlet pesanJadi = $input.first().json.jawaban;\nconst dataUser = $('Persiapan Data').first().json;\n\npesanJadi = pesanJadi.replace(/%NAMA%/g, dataUser.sender_name);\npesanJadi = pesanJadi.replace(/%WAKTU%/g, dataUser.waktu);\n\nreturn {\n  json: {\n    final_message: pesanJadi,\n    target: dataUser.sender_number\n  }\n};"
      },
