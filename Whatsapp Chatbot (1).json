      "parameters": {
        "jsCode": "// 1. Ambil data Body dengan aman\nconst inputData = $input.first().json.body || {};\n\n// 2. Ambil Nama User\nconst namaUser = inputData.pushname || \"Kak\";\n\n// 3. Tentukan Waktu\nconst jam = new Date().getHours();\nlet sapaanWaktu = \"Pagi\";\nif (jam >= 11 && jam < 15) sapaanWaktu = \"Siang\";\nelse if (jam >= 15 && jam < 19) sapaanWaktu = \"Sore\";\nelse if (jam >= 19 || jam < 4) sapaanWaktu = \"Malam\";\n\n// 4. Safety Check & Keyword Clean\nlet keywordRaw = \"\";\nif (inputData.message && inputData.message.text) {\n  keywordRaw = inputData.message.text;\n} else if (inputData.message && inputData.message.conversation) {\n  keywordRaw = inputData.message.conversation;\n}\n\n// 5. INI BAGIAN PENTINGNYA:\nconst pesanAsli = keywordRaw;\nconst keywordBersih = keywordRaw.toLowerCase().trim();\n\nreturn {\n  json: {\n    keyword: keywordBersih,\n    pesan_asli: pesanAsli,   // <-- Ini yang akan kita kirim ke AI nanti\n    sender_number: inputData.from,\n    sender_name: namaUser,\n    waktu: sapaanWaktu\n  }\n};"
      },
