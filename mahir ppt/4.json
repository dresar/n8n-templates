        "name": "Webhook GoWA"
      },
      {
        "parameters": {
          "jsCode": "// PERSIAPAN DATA\nconst inputData = $input.first().json.body || {};\nconst namaUser = inputData.pushname || \"Kak\";\nconst jam = new Date().getHours();\nlet sapaan = \"Pagi\";\nif (jam >= 11 && jam < 15) sapaan = \"Siang\";\nelse if (jam >= 15 && jam < 19) sapaan = \"Sore\";\nelse if (jam >= 19 || jam < 4) sapaan = \"Malam\";\n\nlet msg = \"\";\nif (inputData.message && inputData.message.text) {\n  msg = inputData.message.text;\n} else if (inputData.message && inputData.message.conversation) {\n  msg = inputData.message.conversation;\n}\n\nreturn {\n  json: {\n    keyword: msg.toLowerCase().trim(),\n    pesan_asli: msg,\n    sender_number: inputData.from,\n    sender_name: namaUser,\n    waktu: sapaan\n  }\n};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -1380,
          0
        ],
        "id": "persiapan-data",
        "name": "Persiapan Data"
      },
      {
        "parameters": {
          "operation": "lookup",
          "documentId": {
            "__rl": true,
            "mode": "fromView",
            "value": ""
          },
          "sheetName": {
            "__rl": true,
            "mode": "list",
            "value": ""
          },
          "lookupColumn": "keyword",
          "lookupValue": "={{ $('Persiapan Data').first().json.keyword }}"
        },
        "type": "n8n-nodes-base.googleSheets",
        "typeVersion": 4.5,
        "position": [
          -1160,
