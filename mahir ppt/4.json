      {
        "parameters": {
          "jsCode": "// JALUR ATAS (ADA DI SHEET)\nlet jwb = $input.first().json.jawaban;\nconst u = $('Persiapan Data').first().json;\njwb = jwb.replace(/%NAMA%/g, u.sender_name);\nreturn { json: { final: jwb } };"
        },
        "type": "n8n-nodes-base.code",
