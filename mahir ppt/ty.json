      {
        "parameters": {
          "jsCode": "// --- SUPER FILTER & PRE-PROCESSING ---\n// Node ini menyiapkan semua data agar rapi sebelum diproses\n\nconst input = $input.first().json.body || {};\nconst messageData = input.message || {};\n\n// 1. Ambil Pesan (Text/Conversation/Caption)\nlet originalMessage = \"\";\nif (messageData.text) originalMessage = messageData.text;\nelse if (messageData.conversation) originalMessage = messageData.conversation;\nelse if (messageData.extendedTextMessage && messageData.extendedTextMessage.text) originalMessage = messageData.extendedTextMessage.text;\nelse if (messageData.imageMessage && messageData.imageMessage.caption) originalMessage = messageData.imageMessage.caption;\n\n// 2. Ambil Sender Info\nconst senderNumber = input.from ? input.from.replace('@s.whatsapp.net', '') : '';\nconst pushName = input.pushname || \"Kak\";\nconst isGroup = input.from.includes('@g.us');\n\n// 3. Waktu Sapaan\nconst jam = new Date().getHours();\nlet sapaan = \"Pagi\";\nif (jam >= 11 && jam < 15) sapaan = \"Siang\";\nelse if (jam >= 15 && jam < 19) sapaan = \"Sore\";\nelse sapaan = \"Malam\";\n\n// 4. Keyword Normalization (Kecilkan huruf, hilangkan spasi depan belakang)\nconst keyword = originalMessage.toLowerCase().trim();\n\n// 5. Detect Command (Apakah ini fitur tools?)\n// Jika diawali '!', '#', atau '/' dianggap command\nconst isCommand = /^[!#\\/]/.test(keyword);\nconst commandType = isCommand ? keyword.split(' ')[0].substring(1) : 'chat';\n\nreturn {\n  json: {\n    pesan_asli: originalMessage,\n    keyword: keyword,\n    command_type: commandType,\n    is_command: isCommand,\n    sender_number: input.from, // Pakai format raw untuk reply\n    sender_clean: senderNumber,\n    sender_name: pushName,\n    sapaan: sapaan,\n    is_group: isGroup,\n    timestamp: new Date().toISOString()\n  }\n};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -1380,
          0
        ],
        "id": "preprocessing-core",
        "name": "Core: Data Processing"
      },
